# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.

# Required. Generate one: openssl rand -hex 24
FOODDB__BACKEND__POSTGRES_PASSWORD=

# Signs the /admin session cookie. Without it /admin is not served. Generate one: openssl rand -hex 32
FOODDB__BACKEND__SECRET_KEY=

# Optional.
# FOODDB__DEPLOY__IMAGE=ghcr.io/eait-fit/fooddb:latest  # a published image instead of building locally
# FOODDB__DEPLOY__BIND=127.0.0.1                        # where the API port is published
# FOODDB__DEPLOY__PORT=8000
# FOODDB__BACKEND__MATCH_THRESHOLD=0.95                 # Splink match probability that merges products
# FOODDB__BACKEND__REQUIRE_KEY_FOR_READS=false          # true: reads need an API key too
# FOODDB__BACKEND__RATE_LIMIT_PER_MINUTE=60             # per key, and per client IP for reads without a key
# FOODDB__BACKEND__RAPIDAPI_PROXY_SECRET=               # the X-RapidAPI-Proxy-Secret of your RapidAPI listing
# FOODDB__BACKEND__STALE_AFTER_DAYS=730                 # a value this much older than the newest one loses its trust rank
