# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.

# Required. Generate one: openssl rand -hex 24
FOODDB__BACKEND__POSTGRES_PASSWORD=

# Signs the /admin session cookie. Without it /admin is not served. Generate one: openssl rand -hex 32
FOODDB__BACKEND__SECRET_KEY=

# Optional.
# FOODDB__DEPLOY__IMAGE=ghcr.io/eait-fit/fooddb:latest  # a published image instead of building locally
# FOODDB__DEPLOY__BIND=127.0.0.1                        # where the API port is published
# FOODDB__DEPLOY__PORT=8000
# FOODDB__BACKEND__MATCH_THRESHOLD=0.95                 # Splink match probability that merges products
# FOODDB__BACKEND__REQUIRE_KEY_FOR_READS=false          # true: reads need an API key too
# FOODDB__BACKEND__RATE_LIMIT_PER_MINUTE=60             # per key, and per client IP for reads without a key
# FOODDB__BACKEND__RAPIDAPI_PROXY_SECRET=               # the X-RapidAPI-Proxy-Secret of your RapidAPI listing
# FOODDB__BACKEND__PUBLIC_URL=https://food-api.example.com  # needed for the developer portal: where sign-in and Stripe links point
# FOODDB__BACKEND__RESEND_API_KEY=                      # the portal mails sign-in links through Resend
# FOODDB__BACKEND__MAIL_FROM=fooddb <login@example.com> # a sender your Resend domain verifies
# FOODDB__BACKEND__STRIPE_SECRET_KEY=                   # restricted key: Checkout Sessions write
# FOODDB__BACKEND__STRIPE_WEBHOOK_SECRET=               # signing secret of the endpoint /v1/stripe/webhook
# FOODDB__BACKEND__STRIPE_PRICE_ID=                     # empty: EUR 29.99 inline price
# FOODDB__BACKEND__STRIPE_AUTOMATIC_TAX=false           # true: Stripe Tax on the Checkout session
# FOODDB__BACKEND__STRIPE_TAX_BEHAVIOR=inclusive          # inline price only: inclusive | exclusive
# FOODDB__BACKEND__STRIPE_TAX_CODE=txcd_10000000          # inline price only
# FOODDB__BACKEND__CREDITS_PER_PACK=100000              # requests in one pack
# FOODDB__BACKEND__STALE_AFTER_DAYS=730                 # a value this much older than the newest one loses its trust rank
# FOODDB__BACKEND__REQUEST_LOG_DAYS=30                  # days the request log (/admin Requests page) keeps its rows
# FOODDB__BACKEND__DUMP_KEEP=3                          # how many monthly ODbL dumps of the OFF layer to keep
# FOODDB__BACKEND__LLM_API_KEY=                         # OpenRouter key for label reads; without it reads are demo reads
# FOODDB__BACKEND__LLM_MODEL=qwen/qwen3-vl-235b-a22b-instruct  # the OpenRouter vision model
# FOODDB__BACKEND__LABEL_READER=                        # openrouter (default with a key) | demo
# FOODDB__BACKEND__LABEL_CONFIDENCE_FLOOR=0.9           # a read below this confidence waits for review in full
# FOODDB__BACKEND__FETCH_FDC_BRANDED=false             # true: FDC Branded Foods weekly (~3 GB JSON; see docs/deploy.md)
# FOODDB__BACKEND__FETCH_FINELI=false                   # true: Fineli weekly, from FOODDB__BACKEND__FINELI_URL
# FOODDB__BACKEND__FINELI_URL=                          # a reachable copy of the Fineli open data zip
