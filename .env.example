FOODDB__BACKEND__DATABASE_URL=postgresql://fooddb:fooddb@127.0.0.1:5440/fooddb
# Signs the /admin session cookie. Without it /admin is not served. Generate one: openssl rand -hex 32
FOODDB__BACKEND__SECRET_KEY=
# true: every read needs an API key too. Writes, /mcp review tools and /admin always need one.
FOODDB__BACKEND__REQUIRE_KEY_FOR_READS=false
# Requests per minute per key, and per client IP for reads without a key. A key can override it.
FOODDB__BACKEND__RATE_LIMIT_PER_MINUTE=60
# A request with this X-RapidAPI-Proxy-Secret header counts as a read key. Empty: off.
FOODDB__BACKEND__RAPIDAPI_PROXY_SECRET=
# Proxy addresses whose X-Forwarded-For uvicorn trusts for the client IP. Default: 127.0.0.1.
# FOODDB__BACKEND__FORWARDED_ALLOW_IPS=127.0.0.1
# FOODDB__BACKEND__MATCH_MODEL=match-model.json  # Splink model that `fooddb match train` writes; hand-set weights while absent
# FOODDB__BACKEND__DUMP_DIR=dumps  # where the monthly ODbL dump of the OFF layer is written and served from
# FOODDB__BACKEND__DUMP_KEEP=3     # how many monthly dumps to keep
# Label reads. LABEL_READER: openrouter | claude-cli | codex-cli | demo. Default: openrouter with an LLM key, else
# demo (canned, never served without review). The OpenRouter account reaches x-ai and Chinese-vendor models only.
# FOODDB__BACKEND__LABEL_READER=
# FOODDB__BACKEND__LLM_API_KEY=
# FOODDB__BACKEND__LLM_MODEL=qwen/qwen3-vl-235b-a22b-instruct
# FOODDB__BACKEND__LABEL_CONFIDENCE_FLOOR=0.9  # a server read below this confidence waits for review in full
# FOODDB__BACKEND__PHOTO_DIR=photos            # label photos, stored once by SHA-256
# GS1 check of brand uploads. Only none exists: it answers unknown, so every brand upload waits for review.
# FOODDB__BACKEND__GS1_VERIFIER=none
# The MCP tool read_label with submit=true posts a local read here, with a contribute key.
# FOODDB__BACKEND__SUBMIT_URL=https://food-api.eait.fit
# FOODDB__BACKEND__SUBMIT_KEY=
# FOODDB__BACKEND__STALE_AFTER_DAYS=730  # a nutrient value this much older than the newest one loses its trust rank
# FOODDB__BACKEND__FETCH_FDC_BRANDED=false  # true: fetch FDC Branded Foods weekly (~200 MB zip, ~3 GB JSON, hours to load)
# FOODDB__BACKEND__FETCH_FINELI=false       # true: fetch Fineli weekly; fineli.fi refuses automated downloads, so set a mirror
# FOODDB__BACKEND__FINELI_URL=https://fineli.fi/fineli/content/file/47  # the Fineli open data zip (basic package 1)
